{
  "name": "@cl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed Client Ledger API client (TanStack Query hooks + zod schemas) generated by orval from the backend's OpenAPI spec",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./zod": "./src/generated/zod.ts"
  },
  "scripts": {
    "fetch-spec": "node scripts/fetch-spec.mjs",
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "orval": "^8.38.0",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

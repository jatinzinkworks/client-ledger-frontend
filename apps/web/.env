# Backend origin. Empty = the app's own origin: in dev the Vite server proxies /psc to
# VITE_DEV_PROXY_TARGET (the backend sends no CORS headers, so the browser cannot call
# :8080 directly); in production, serve the app and API from the same origin.
# Set a full URL (e.g. http://localhost:8080) only if that backend allows this origin via CORS.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_LOGOUT_URL=/?gcp-iap-mode=CLEAR_LOGIN_COOKIE
# Identity provider end-session endpoint. Without it, signing out will not
# prompt for credentials again. For Entra:
# https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/logout
VITE_IDP_LOGOUT_URL=https://login.microsoftonline.com/041daa82-3257-4a99-b7de-d0118b3ed5b4/oauth2/v2.0/logout
